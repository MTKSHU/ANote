FROM node:22-bookworm
SHELL ["/bin/bash", "-c"]
RUN apt-get update && apt-get install -y --no-install-recommends openjdk-17-jdk-headless ca-certificates curl unzip && rm -rf /var/lib/apt/lists/*
ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
ENV ANDROID_HOME=/opt/android-sdk
ENV ANDROID_SDK_ROOT=/opt/android-sdk
ENV PATH=/opt/gradle/bin:/opt/android-sdk/cmdline-tools/13.0/bin:/opt/android-sdk/platform-tools:$PATH
# SDK commandline-tools 13.0 checksum from Google's repository2-1.xml.
RUN curl --retry 5 --retry-all-errors --retry-delay 2 -fsSL https://dl.google.com/android/repository/commandlinetools-linux-11479570_latest.zip -o /tmp/android-tools.zip \
 && echo '2e1a11866ce7146dee1456152ff64d6c8158b2c0  /tmp/android-tools.zip' | sha1sum -c - \
 && mkdir -p /opt/android-sdk/cmdline-tools/13.0 \
 && unzip -q /tmp/android-tools.zip -d /tmp/android-tools \
 && mv /tmp/android-tools/cmdline-tools/* /opt/android-sdk/cmdline-tools/13.0/ \
 && rm -rf /tmp/android-tools /tmp/android-tools.zip
RUN yes | sdkmanager --sdk_root=/opt/android-sdk --licenses >/dev/null
RUN sdkmanager --sdk_root=/opt/android-sdk 'platforms;android-35' 'build-tools;35.0.0' 'platform-tools'
# Mirror transfer, verified against the checksum published by services.gradle.org.
RUN curl --connect-timeout 20 --max-time 300 --retry 3 --retry-all-errors --retry-delay 2 -fsSL https://repo.huaweicloud.com/gradle/gradle-8.11.1-bin.zip -o /tmp/gradle.zip \
 && echo 'f397b287023acdba1e9f6fc5ea72d22dd63669d59ed4a289a29b1a76eee151c6  /tmp/gradle.zip' | sha256sum -c - \
 && unzip -q /tmp/gradle.zip -d /opt \
 && mv /opt/gradle-8.11.1 /opt/gradle \
 && rm /tmp/gradle.zip
COPY tools/build-android.sh /usr/local/bin/anote-build-android
ENTRYPOINT ["/usr/local/bin/anote-build-android"]
