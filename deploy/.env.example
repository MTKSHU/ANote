# Initial setup only: after first start, platform management stores OIDC configuration in the database.
# Copy optional bootstrap settings into deploy/.env. Keep actual secrets out of Git.
# Initial ADMIN_PASSWORD / DB_PASSWORD are generated by the deployment scripts.
# CASDOOR_SERVER_URL=https://auth.example.org
CASDOOR_SERVER_URL=
CASDOOR_CLIENT_ID=
CASDOOR_CLIENT_SECRET=
# Optional: use the application's own OIDC discovery/JWKS when it has a separate certificate.
CASDOOR_APPLICATION=
# Optional public address for a new database; update existing settings in the web UI.
# PUBLIC_ORIGIN=https://notes.example.org
# Set true only if all browser access uses HTTPS; false preserves direct HTTP LAN login.
COOKIE_SECURE=false
# Generated in Docker by init-env.mjs / ensure-settings-key.mjs; retain it when moving the database.
SETTINGS_ENCRYPTION_KEY=
